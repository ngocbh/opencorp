    "@solidjs/router": "1.0.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "clipboardy": "4.0.0",
    "diff": "8.0.2",
    "effect": "4.0.0-beta.83",
    "fuzzysort": "3.1.0",
    "open": "11.0.4",
    "opentui-spinner": "0.0.7",
    "remeda": "2.26.0",
    "solid-js": "1.9.10",
    "strip-ansi": "7.1.2"
