[Unit]
Description=OpenCorp office at /Users/owner/.opencorp
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/opencorp
Environment="HOME=/Users/owner"
Environment="PATH=/usr/bin:/bin"
ExecStart=/opt/opencorp/.venv/bin/python -m opencorp.daemon.main --home /Users/owner/.opencorp
StandardOutput=append:/Users/owner/.opencorp/office/office.log
StandardError=append:/Users/owner/.opencorp/office/office.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
