[Unit]
Description=agent-corp office at /Users/owner/.agent-corp
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/agent-corp
Environment="HOME=/Users/owner"
Environment="PATH=/usr/bin:/bin"
ExecStart=/opt/agent-corp/.venv/bin/python -m agent_corp.daemon.main --home /Users/owner/.agent-corp
StandardOutput=append:/Users/owner/.agent-corp/office/office.log
StandardError=append:/Users/owner/.agent-corp/office/office.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
