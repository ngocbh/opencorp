<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/owner</string>
		<key>PATH</key>
		<string>/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.opencorp.office</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/opencorp/.venv/bin/python</string>
		<string>-m</string>
		<string>opencorp.daemon.main</string>
		<string>--home</string>
		<string>/Users/owner/.opencorp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/owner/.opencorp/office/office.log</string>
	<key>StandardOutPath</key>
	<string>/Users/owner/.opencorp/office/office.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/opt/opencorp</string>
</dict>
</plist>
